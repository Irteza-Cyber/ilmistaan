rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muhammadirteza2024@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function notSuspended(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) ||
        get(/databases/$(database)/documents/users/$(userId)).data.isSuspended != true;
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        (request.resource.data.role == 'student' || isAdmin()) &&
        (request.resource.data.isSuspended == false || isAdmin());
      allow update: if (isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isSuspended == resource.data.isSuspended) || isAdmin();
      allow delete: if isAdmin();

      // Semesters
      match /semesters/{semesterId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidId(semesterId) && notSuspended(userId);
      }

      // Courses
      match /courses/{courseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidId(courseId) && notSuspended(userId);
      }

      // Assignments
      match /assignments/{assignmentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidId(assignmentId) && notSuspended(userId);
      }

      // Lectures
      match /lectures/{lectureId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidId(lectureId) && notSuspended(userId);
      }

      // Quizzes
      match /quizzes/{quizId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidId(quizId) && notSuspended(userId);
      }

      // Chat Messages
      match /chatMessages/{messageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidId(messageId) && notSuspended(userId);
      }
    }
  }
}
